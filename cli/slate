def block_chips(block_id: str, prof: str) -> tuple[list[str], str | None]:
    """Return (chips, open_target) — open_target is best token for `slate open`."""
    chips: list[str] = []
    open_target: str | None = None
    for nid in neighbors(block_id, prof):
        c = get_node(nid, prof)
        if not c:
            continue
        if c["kind"] == "jira":
            key = (c.get("refs") or {}).get("jira", "jira")
            chips.append(key)
            open_target = open_target or key
        elif c["kind"] == "code_review":
            chips.append("pr")
            url = (c.get("refs") or {}).get("url")
            open_target = open_target or url
        elif c["kind"] == "slack":
            chips.append("slack")
            url = (c.get("refs") or {}).get("url")
            open_target = open_target or url
        elif c["kind"] == "agent_session":
            chips.append("sess")
    return chips, open_target


def cmd_ls(args: argparse.Namespace) -> None:
    # Always both profiles — cwd auto-profile made `ls` look empty outside Ithaka.
    profiles = ["ithaka", "personal"]
    if args.profile:
        profiles = [args.profile]
    rows: list[dict[str, Any]] = []
    for prof in profiles:
        nodes = load_nodes(prof)
        blocks = [n for n in nodes if n.get("kind") == "block"]
        if not args.all:
            blocks = [n for n in blocks if n.get("status") == "open"]
        else:
            blocks = blocks[-20:]
        for b in blocks:
            chips, _open_target = block_chips(b["id"], prof)
            rows.append(
                {
                    "id": b["id"],
                    "profile": prof,
                    "title": b.get("title") or "",
                    "status": b.get("status") or "",
                    "next": b.get("next") or "",
                    "chips": chips,
                    # Always the block id — panel/launcher call `slate open <id>` to
                    # continue. Jira/PR/Slack tokens are for `slate open KEY|URL` (park+start).
                    "open": b["id"],
                    "note": (b.get("notes") or [{}])[-1].get("text", "") if b.get("notes") else "",
                }
            )
    if args.json:
        print(json.dumps(rows))
        return
    by_prof: dict[str, list[dict[str, Any]]] = {}
    for r in rows:
        by_prof.setdefault(r["profile"], []).append(r)
    for prof, items in by_prof.items():
        print(f"# {prof}")
        for r in items:
            chip_s = " ".join(r["chips"])
            nxt = r["next"]
            print(
                f"{r['id']}  [{r['status']}]  {r['title']}  {chip_s}"
                + (f"  next={nxt}" if nxt else "")
            )

def parse_jira_token(token: str) -> str:
    token = token.strip()
    if token.startswith(("http://", "https://")):
        m = JIRA_BROWSE_RE.search(token)
        if m:
            return m.group(1).upper()
        m = JIRA_KEY_RE.search(token)
        if m:
            return m.group(1).upper()
        die(f"no jira key in url: {token}")
    if token.upper().startswith("JIRA:"):
        return token.split(":", 1)[1].upper()
    m = JIRA_KEY_RE.fullmatch(token.upper()) if token.isupper() or "-" in token else JIRA_KEY_RE.fullmatch(token)
    # accept PROJ-123 case-insensitive
    m = re.fullmatch(r"([A-Za-z][A-Za-z0-9]+-\d+)", token)
    if m:
        return m.group(1).upper()
    die(f"not a jira key or browse url: {token}")


