def cmd_done_block(args: argparse.Namespace) -> None:
    token = args.id
    node = resolve_node(token)
    if not node and JIRA_KEY_RE.fullmatch(token or ""):
        node = find_block_for_jira(token)
    if not node:
        # jira:KEY → block
        if token.startswith("jira:"):
            node = find_block_for_jira(token.split(":", 1)[1])
        elif token.startswith(("http://", "https://")):
            cr = resolve_node(token)
            if cr:
                for nid in neighbors(cr["id"]):
                    n = get_node(nid)
                    if n and n.get("kind") == "block":
                        node = n
                        break
    if not node:
        die(f"unknown block {token}")
    if node.get("kind") != "block":
        # if given a child, find its block
        for nid in neighbors(node["id"]):
            n = get_node(nid)
            if n and n.get("kind") == "block":
                node = n
                break
        else:
            die("not a block (and no linked block found)")
    update_node(node["id"], status="done", ended=now())
    for nid in neighbors(node["id"]):
        child = get_node(nid)
        if child and child.get("status") == "open":
            update_node(nid, status="done", ended=now())
    print(node["id"])


def cmd_prune(args: argparse.Namespace) -> None:
    """Collapse duplicate open agent_sessions — one keeper per block."""
    blocks: list[dict[str, Any]] = []
    if args.block:
        node = resolve_node(args.block)
        if not node:
            die(f"unknown {args.block}")
        if node.get("kind") != "block":
            found = None
            for nid in neighbors(node["id"], node_profile(node)):
                n = get_node(nid, node_profile(node))
                if n and n.get("kind") == "block":
                    found = n
                    break
            node = found or die("not a block (and no linked block found)")
        blocks = [node]
    else:
        for prof in ("ithaka", "personal"):
            for n in load_nodes(prof):
                if n.get("kind") == "block" and n.get("status") == "open":
                    blocks.append(n)

    for block in blocks:
        before = open_agent_sessions(block)
        if len(before) <= 1:
            continue
        keeper = prune_open_sessions(block)
        print(f"{block['id']}: kept {keeper}, closed {len(before) - 1} duplicate session(s)")


