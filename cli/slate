#!/usr/bin/env python3
"""slate — personal work ledger (block cards + linked children)."""
from __future__ import annotations

import argparse
import json
import os
import random
import re
import secrets
import shlex
import subprocess
import sys
import tomllib
from datetime import datetime, timezone
from pathlib import Path
from typing import Any
