DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "slate"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "slate"
STATE = CONFIG / "state.json"
ITHAKA_PREFIX = "/work/Developer/Ithaka"

JIRA_KEY_RE = re.compile(r"\b([A-Z][A-Z0-9]+-\d+)\b")
JIRA_BROWSE_RE = re.compile(r"/browse/([A-Z][A-Z0-9]+-\d+)", re.I)
PR_URL_RE = re.compile(r"/(?:pull|merge_requests)/\d+")
SLACK_URL_RE = re.compile(
    r"https?://[^\s]*slack\.com/(?:archives|client)/[^\s]+", re.I
)

def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def new_id() -> str:
    return secrets.token_hex(4)


def die(msg: str, code: int = 1) -> None:
    print(f"slate: {msg}", file=sys.stderr)
    raise SystemExit(code)


def load_state() -> dict[str, Any]:
    if STATE.exists():
        return json.loads(STATE.read_text())
    return {}


def save_state(state: dict[str, Any]) -> None:
    CONFIG.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=2) + "\n")


def profile_for_cwd(cwd: str | None = None) -> str:
    cwd = os.path.realpath(cwd or os.getcwd())
    if cwd == ITHAKA_PREFIX or cwd.startswith(ITHAKA_PREFIX + os.sep):
        return "ithaka"
    return "personal"


def configured_default_profile() -> str:
    """Fallback when cwd is not under Ithaka and nothing is pinned."""
    return load_state().get("default") or "personal"


def active_profile() -> str:
    state = load_state()
    if state.get("pinned"):
        return state["pinned"]
    auto = profile_for_cwd()
    if auto == "ithaka":
        return "ithaka"
    # Launcher / noctalia / home shells: use marked default (often ithaka).
    return configured_default_profile()


def profile_dir(profile: str | None = None) -> Path:
    p = DATA / (profile or active_profile())
    p.mkdir(parents=True, exist_ok=True)
    return p


def nodes_path(profile: str | None = None) -> Path:
    return profile_dir(profile) / "nodes.jsonl"


def edges_path(profile: str | None = None) -> Path:
    return profile_dir(profile) / "edges.jsonl"


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    out = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if line:
            out.append(json.loads(line))
    return out


def write_jsonl(path: Path, rows: list[dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(json.dumps(r, separators=(",", ":")) + "\n" for r in rows))


def append_jsonl(path: Path, row: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as f:
        f.write(json.dumps(row, separators=(",", ":")) + "\n")


def load_nodes(profile: str | None = None) -> list[dict[str, Any]]:
    return read_jsonl(nodes_path(profile))


def save_nodes(nodes: list[dict[str, Any]], profile: str | None = None) -> None:
    write_jsonl(nodes_path(profile), nodes)


def load_edges(profile: str | None = None) -> list[dict[str, Any]]:
    return read_jsonl(edges_path(profile))


def save_edges(edges: list[dict[str, Any]], profile: str | None = None) -> None:
    write_jsonl(edges_path(profile), edges)


def get_node(nid: str, profile: str | None = None) -> dict[str, Any] | None:
    for n in load_nodes(profile):
        if n["id"] == nid:
            return n
    return None


def _resolve_in(token: str, profile: str) -> dict[str, Any] | None:
    """id | jira:KEY | url within one profile."""
    nodes = load_nodes(profile)
    if re.fullmatch(r"[0-9a-f]{8}", token):
        for n in nodes:
            if n["id"] == token:
                return n
    if token.startswith("jira:"):
        key = token.split(":", 1)[1].upper()
        for n in nodes:
            if n.get("kind") == "jira" and (n.get("refs") or {}).get("jira") == key:
                return n
    if token.startswith(("http://", "https://")):
        for n in nodes:
            if (n.get("refs") or {}).get("url") == token:
                return n
    m = JIRA_KEY_RE.fullmatch(token)
    if m:
        key = m.group(1).upper()
        for n in nodes:
            if n.get("kind") == "jira" and (n.get("refs") or {}).get("jira") == key:
                return n
    return None


def resolve_node(token: str, profile: str | None = None) -> dict[str, Any] | None:
    """id | jira:KEY | url. Searches all profiles unless profile= is set."""
    if profile:
        return _resolve_in(token, profile)
    seen: set[str] = set()
    for p in (active_profile(), "ithaka", "personal"):
        if p in seen:
            continue
        seen.add(p)
        n = _resolve_in(token, p)
        if n:
            return n
    return None


def node_profile(node: dict[str, Any]) -> str:
    return node.get("profile") or active_profile()


def profile_root(profile: str | None = None) -> str | None:
    profile = profile or active_profile()
    cfg = CONFIG / f"{profile}.toml"
    if not cfg.exists():
        return None
    data = tomllib.loads(cfg.read_text())
    root = data.get("root")
    return os.path.realpath(root) if root else None


def resolve_root(explicit: str | None, profile: str | None = None) -> str:
    if explicit:
        return os.path.realpath(explicit)
    pr = profile_root(profile)
    if pr:
        return pr
    return os.path.realpath(os.getcwd())


def neighbors(nid: str, profile: str | None = None) -> list[str]:
    out = []
    for e in load_edges(profile):
        if e["a"] == nid:
            out.append(e["b"])
        elif e["b"] == nid:
            out.append(e["a"])
    return out


def ensure_link(a: str, b: str, profile: str | None = None) -> None:
    if a == b:
        die("cannot link a node to itself")
    x, y = sorted([a, b])
    edges = load_edges(profile)
    for e in edges:
        if sorted([e["a"], e["b"]]) == [x, y]:
            return
    edges.append({"id": new_id(), "a": x, "b": y, "rel": "related", "at": now()})
    save_edges(edges, profile)


def update_node(nid: str, profile: str | None = None, **fields: Any) -> dict[str, Any]:
    if profile is None:
        for p in ("ithaka", "personal", active_profile()):
            if get_node(nid, p):
                profile = p
                break
        else:
            die(f"unknown node {nid}")
    nodes = load_nodes(profile)
    for i, n in enumerate(nodes):
        if n["id"] == nid:
            n.update(fields)
            nodes[i] = n
            save_nodes(nodes, profile)
            return n
    die(f"unknown node {nid}")


def cmd_profile(args: argparse.Namespace) -> None:
    state = load_state()
    parts: list[str] = list(args.name or [])
    if not parts:
        pinned = state.get("pinned")
        default = configured_default_profile()
        auto = profile_for_cwd()
        active = active_profile()
        if pinned:
            how = "pinned"
        elif auto == "ithaka":
            how = f"auto from cwd → {auto}"
        else:
            how = f"default → {default}"
        print(f"active: {active} ({how})")
        print(f"default: {default}")
        if pinned:
            print(f"pinned: {pinned}")
        return
    if parts[0] == "default":
        if len(parts) != 2 or parts[1] not in ("ithaka", "personal"):
            die("usage: slate profile default ithaka|personal")
        state["default"] = parts[1]
        save_state(state)
        print(f"default: {parts[1]}")
        return
    if parts[0] == "auto":
        state.pop("pinned", None)
        save_state(state)
        print(f"unpinned; active → {active_profile()}")
        return
    if len(parts) != 1 or parts[0] not in ("ithaka", "personal"):
        die("usage: slate profile [ithaka|personal|auto|default ithaka|personal]")
    state["pinned"] = parts[0]
    save_state(state)
    print(f"pinned: {parts[0]}")


def cmd_block_start(args: argparse.Namespace) -> None:
    title = " ".join(args.title) if args.title else "untitled"
    nid = new_id()
    node = {
        "id": nid,
        "profile": active_profile(),
        "kind": "block",
        "title": title,
        "status": "open",
        "next": args.next or "",
        "notes": [],
        "started": now(),
        "ended": None,
        "refs": {},
    }
    append_jsonl(nodes_path(), node)
    print(nid)


def find_block_for_jira(key: str) -> dict[str, Any] | None:
    key = key.upper()
    jira = resolve_node(f"jira:{key}")
    if not jira:
        return None
    for nid in neighbors(jira["id"]):
        n = get_node(nid)
        if n and n.get("kind") == "block" and n.get("status") == "open":
            return n
    return None


def ensure_jira(key: str, title: str | None = None) -> dict[str, Any]:
    key = key.upper()
    existing = resolve_node(f"jira:{key}")
    if existing:
        return existing
    nid = new_id()
    node = {
        "id": nid,
        "profile": active_profile(),
        "kind": "jira",
        "title": title or key,
        "status": "open",
        "notes": [],
        "started": now(),
        "ended": None,
        "refs": {"jira": key},
    }
    append_jsonl(nodes_path(), node)
    return node


def ensure_block_for_jira(key: str, title: str | None = None) -> dict[str, Any]:
    key = key.upper()
    block = find_block_for_jira(key)
    if block:
        return block
    jira = ensure_jira(key, title)
    bid = new_id()
    block = {
        "id": bid,
        "profile": active_profile(),
        "kind": "block",
        "title": title or f"{key}",
        "status": "open",
        "next": "",
        "notes": [],
        "started": now(),
        "ended": None,
        "refs": {},
    }
    append_jsonl(nodes_path(), block)
    ensure_link(bid, jira["id"])
    return block


def is_pr_url(url: str) -> bool:
    return bool(PR_URL_RE.search(url))


def is_slack_url(url: str) -> bool:
    return bool(SLACK_URL_RE.search(url))


def ensure_slack(url: str, title: str | None = None) -> dict[str, Any]:
    for n in load_nodes():
        if n.get("kind") == "slack" and (n.get("refs") or {}).get("url") == url:
            return n
    nid = new_id()
    short = url if len(url) <= 60 else url[:57] + "…"
    node = {
        "id": nid,
        "profile": active_profile(),
        "kind": "slack",
        "title": title or short,
        "status": "open",
        "notes": [],
        "started": now(),
        "ended": None,
        "refs": {"url": url},
    }
    append_jsonl(nodes_path(), node)
    return node


def ensure_block_for_slack(url: str, title: str | None = None) -> dict[str, Any]:
    slack = ensure_slack(url, title)
    for nid in neighbors(slack["id"]):
        n = get_node(nid)
        if n and n.get("kind") == "block" and n.get("status") == "open":
            return n
    bid = new_id()
    short = title or (url if len(url) <= 48 else url[:45] + "…")
    block = {
        "id": bid,
        "profile": active_profile(),
        "kind": "block",
        "title": short,
        "status": "open",
        "next": "triage Slack thread",
        "notes": [],
        "started": now(),
        "ended": None,
        "refs": {},
    }
    append_jsonl(nodes_path(), block)
    ensure_link(bid, slack["id"])
    return block


def ensure_block_for_review(
    url: str, title: str | None = None, jira: str | None = None
) -> tuple[dict[str, Any], str]:
    """Return (block, code_review_id). Same graph as `slate review`."""
    existing = resolve_node(url)
    if existing:
        cr_id = existing["id"]
    else:
        cr_id = new_id()
        append_jsonl(
            nodes_path(),
            {
                "id": cr_id,
                "profile": active_profile(),
                "kind": "code_review",
                "title": title or review_title_from_url(url),
                "status": "open",
                "notes": [],
                "started": now(),
                "ended": None,
                "refs": {"url": url},
            },
        )
    block = None
    for nid in neighbors(cr_id):
        n = get_node(nid)
        if n and n.get("kind") == "block" and n.get("status") == "open":
            block = n
            break
    if not block:
        bid = new_id()
        block = {
            "id": bid,
            "profile": active_profile(),
            "kind": "block",
            "title": title or review_title_from_url(url),
            "status": "open",
            "next": "read diff / leave comments",
            "notes": [],
            "started": now(),
            "ended": None,
            "refs": {},
        }
        append_jsonl(nodes_path(), block)
        ensure_link(bid, cr_id)
    if jira:
        j = ensure_jira(jira.upper())
        ensure_link(block["id"], j["id"])
    return block, cr_id


# Same distinct dark hues as home/basit/fish/kitty-window-bg.fish — conf.d only
# runs for interactive fish; we still set colors here for the OS window.
_KITTY_BG_COLORS = (
    "#1a1028",
    "#10201a",
    "#201010",
    "#102028",
    "#281810",
    "#101828",
    "#182010",
    "#281028",
)


def _kitty_pids_listening() -> list[int]:
    """PIDs from abstract sockets @kitty-wisp-<pid> (apps.nix listen_on)."""
    try:
        out = subprocess.check_output(["ss", "-lx"], text=True, stderr=subprocess.DEVNULL)
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []
    pids: list[int] = []
    for line in out.splitlines():
        m = re.search(r"@kitty-wisp-(\d+)\b", line)
        if m:
            pids.append(int(m.group(1)))
    return pids


def _proc_cmdline(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
    except OSError:
        return ""


def _pid_is_live_kitty(pid: int) -> bool:
    if pid <= 0 or not Path(f"/proc/{pid}").exists():
        return False
    return "kitty" in _proc_cmdline(pid)


def _owning_kitty_pid() -> int | None:
    """Walk parents from this process to find the kitty OS window (for `slate start` in-session)."""
    pid = os.getpid()
    for _ in range(12):
        try:
            status = Path(f"/proc/{pid}/status").read_text()
            ppid = int(next(line for line in status.splitlines() if line.startswith("PPid:")).split()[1])
        except (OSError, StopIteration, ValueError):
            return None
        if ppid <= 1:
            return None
        if _pid_is_live_kitty(ppid):
            return ppid
        pid = ppid
    return None


def _kitty_pid_for_claude_session(claude_sid: str) -> int | None:
    """Fallback discover: cmdline --resume <uuid>, or CLAUDE_CODE_SESSION_ID via remote control."""
    if not claude_sid:
        return None
    for pid in _kitty_pids_listening():
        if claude_sid in _proc_cmdline(pid):
            return pid
    for pid in _kitty_pids_listening():
        try:
            raw = subprocess.check_output(
                ["kitten", "@", "--to", f"unix:@kitty-wisp-{pid}", "ls"],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=2,
            )
            data = json.loads(raw)
        except (FileNotFoundError, subprocess.CalledProcessError, json.JSONDecodeError, TimeoutError):
            continue
        for osw in data if isinstance(data, list) else []:
            for tab in osw.get("tabs") or []:
                for win in tab.get("windows") or []:
                    env = win.get("env") or {}
                    if env.get("CLAUDE_CODE_SESSION_ID") == claude_sid:
                        return pid
    return None


def focus_hypr_pid(pid: int) -> bool:
    """Raise Hyprland window for OS pid. Hyprland 0.55 Lua dispatchers."""
    if not _pid_is_live_kitty(pid):
        return False
    expr = f'hl.dsp.focus({{ window = "pid:{pid}" }})'
    try:
        r = subprocess.run(
            ["hyprctl", "dispatch", expr],
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0 and (r.stdout or "").strip().lower() == "ok"


def open_agent_sessions(block: dict[str, Any]) -> list[dict[str, Any]]:
    prof = node_profile(block)
    out: list[dict[str, Any]] = []
    for nid in neighbors(block["id"], prof):
        c = get_node(nid, prof)
        if c and c.get("kind") == "agent_session" and c.get("status") == "open":
            out.append(c)
    out.sort(key=lambda n: str(n.get("started") or ""), reverse=True)
    return out


def _session_rank(sess: dict[str, Any]) -> tuple[int, int, str]:
    """Prefer Claude UUID + live kitty_pid, then newest."""
    cs = 1 if (sess.get("refs") or {}).get("claude_session") else 0
    pid = sess.get("kitty_pid")
    live = 0
    if isinstance(pid, int) and _pid_is_live_kitty(pid):
        live = 1
    elif isinstance(pid, str) and pid.isdigit() and _pid_is_live_kitty(int(pid)):
        live = 1
    return (cs, live, str(sess.get("started") or ""))


def prune_open_sessions(block: dict[str, Any]) -> str | None:
    """Keep one open agent_session per block; mark the rest done. Returns keeper id."""
    sessions = open_agent_sessions(block)
    if not sessions:
        return None
    if len(sessions) == 1:
        return sessions[0]["id"]
    sessions.sort(key=_session_rank, reverse=True)
    keeper = sessions[0]
    prof = node_profile(block)
    for sess in sessions[1:]:
        update_node(sess["id"], profile=prof, status="done", ended=now())
    return keeper["id"]


def focus_block_window(block: dict[str, Any]) -> bool:
    """Focus existing kitty for this block: stored kitty_pid first, then Claude UUID discover."""
    prune_open_sessions(block)
    for sess in open_agent_sessions(block):
        pid = sess.get("kitty_pid")
        if isinstance(pid, int) and focus_hypr_pid(pid):
            return True
        if isinstance(pid, str) and pid.isdigit() and focus_hypr_pid(int(pid)):
            return True
    for sess in open_agent_sessions(block):
        cs = (sess.get("refs") or {}).get("claude_session")
        if not cs:
            continue
        pid = _kitty_pid_for_claude_session(str(cs))
        if pid and focus_hypr_pid(pid):
            return True
    return False


def launch_claude(
    root: str,
    tab_title: str,
    seed: str | None,
    *,
    resume_id: str | None = None,
    continue_session: bool = False,
) -> int | None:
    """Spawn kitty+claude; return kitty OS-window pid (for agent_session.kitty_pid)."""
    bg = random.choice(_KITTY_BG_COLORS)
    # Login fish pulls hm-sessionPath + conf.d (switchboard/twg/mise). Noctalia's
    # systemd PATH does not — don't hardcode dirs; track fish/session config.
    if resume_id:
        fish_c = f"exec claude --resume {shlex.quote(resume_id)}"
    elif continue_session:
        fish_c = "exec claude --continue"
    else:
        fish_c = f"exec claude {shlex.quote(seed or '')}"
    cmd = [
        "kitty",
        "--directory",
        root,
        "-o",
        f"tab_title={tab_title}",
        "-o",
        f"background={bg}",
        "-o",
        f"tab_bar_background={bg}",
        "-o",
        f"tab_bar_margin_color={bg}",
        "-o",
        "active_tab_background=#d8d8d8",
        "-o",
        "active_tab_foreground=#1a1a1a",
        "-o",
        f"inactive_tab_background={bg}",
        "-o",
        "inactive_tab_foreground=#9a9a9a",
        "fish",
        "-l",
        "-c",
        fish_c,
    ]
    try:
        proc = subprocess.Popen(cmd, start_new_session=True)
    except FileNotFoundError as e:
        die(f"launch failed: {e}")
    return proc.pid


def ensure_agent_session(
    block: dict[str, Any],
    *,
    root: str,
    title: str,
    kitty_pid: int | None = None,
    claude_sid: str | None = None,
) -> str:
    """Reuse the keeper open agent_session on block; prune duplicates; else create."""
    prof = node_profile(block)
    prune_open_sessions(block)
    sessions = open_agent_sessions(block)
    refs_update: dict[str, Any] = {}
    if claude_sid:
        refs_update["claude_session"] = claude_sid

    if sessions:
        sess = sessions[0]
        fields: dict[str, Any] = {}
        if kitty_pid:
            fields["kitty_pid"] = kitty_pid
        if title and title != sess.get("title"):
            # Prefer a skill-provided title over a bare key seed title.
            if sess.get("title") in ("", None, block.get("title"), block.get("id")):
                fields["title"] = title
        if refs_update:
            refs = dict(sess.get("refs") or {})
            refs.update(refs_update)
            fields["refs"] = refs
        if fields:
            update_node(sess["id"], profile=prof, **fields)
        return sess["id"]

    sid = new_id()
    append_jsonl(
        nodes_path(prof),
        {
            "id": sid,
            "profile": prof,
            "kind": "agent_session",
            "title": title,
            "status": "open",
            "root": root,
            "notes": [],
            "started": now(),
            "ended": None,
            "refs": dict(refs_update),
            "kitty_pid": kitty_pid,
        },
    )
    ensure_link(sid, block["id"], prof)
    return sid


def cmd_start(args: argparse.Namespace) -> None:
    title = " ".join(args.title) if args.title else "session"
    root = resolve_root(args.root)
    block: dict[str, Any]
    if args.jira:
        block = ensure_block_for_jira(args.jira, title=f"{args.jira} · {title}")
    elif args.block:
        found = get_node(args.block) or resolve_node(args.block)
        if not found or found.get("kind") != "block":
            die(f"unknown block {args.block}")
        block = found
    else:
        block_id = new_id()
        block = {
            "id": block_id,
            "profile": active_profile(),
            "kind": "block",
            "title": title,
            "status": "open",
            "next": "",
            "notes": [],
            "started": now(),
            "ended": None,
            "refs": {},
        }
        append_jsonl(nodes_path(), block)
    # Agent Bash exposes CLAUDE_CODE_SESSION_ID; skill should pass --claude-session too.
    claude_sid = (args.claude_session or os.environ.get("CLAUDE_CODE_SESSION_ID") or "").strip() or None
    # Reuse open session from slate open when present; record kitty OS pid + Claude UUID.
    sid = ensure_agent_session(
        block,
        root=root,
        title=title,
        kitty_pid=_owning_kitty_pid(),
        claude_sid=claude_sid,
    )
    if os.environ.get("KITTY_WINDOW_ID"):
        try:
            env = os.environ.copy()
            env.pop("KITTY_LISTEN_ON", None)
            subprocess.run(
                ["kitten", "@", "set-tab-title", "--match", "state:self", title],
                env=env,
                check=False,
                capture_output=True,
            )
        except FileNotFoundError:
            pass
    print(sid)
    extra = f" claude_session={claude_sid}" if claude_sid else " claude_session=(none)"
    print(f"block={block['id']} root={root}{extra}", file=sys.stderr)


