    print(block["id"])


def _best_claude_resume(block: dict[str, Any]) -> str | None:
    for sess in open_agent_sessions(block):
        cs = (sess.get("refs") or {}).get("claude_session")
        if cs:
            return str(cs)
    return None


def open_existing_block(block: dict[str, Any], root: str | None = None) -> None:
    """Focus stored kitty_pid / discover by Claude UUID; else --resume; else seed."""
    prof = node_profile(block)
    root_dir = resolve_root(root, profile=prof)
    if not Path(root_dir).is_dir():
        die(f"root is not a directory: {root_dir}")
    title = block.get("title") or block["id"]
    chips, _ = block_chips(block["id"], prof)

    if focus_block_window(block):
        print(f"block={block['id']} profile={prof} focused existing kitty", file=sys.stderr)
        print(block["id"])
        return

    resume_id = _best_claude_resume(block)
    if resume_id:
        print(
            f"block={block['id']} profile={prof} root={root_dir} resume={resume_id}",
            file=sys.stderr,
        )
        pid = launch_claude(root_dir, title[:48], None, resume_id=resume_id)
        ensure_agent_session(block, root=root_dir, title=title, kitty_pid=pid, claude_sid=resume_id)
        print(block["id"])
        return

    parts = [f"Continue work on {title}."]
    if block.get("next"):
        parts.append(f"Next: {block['next']}")
    if chips:
        parts.append("Linked: " + ", ".join(chips))
    notes = block.get("notes") or []
    if notes:
        parts.append("Latest note: " + str(notes[-1].get("text", ""))[:400])
    print(f"block={block['id']} profile={prof} root={root_dir} resume=seed", file=sys.stderr)
    pid = launch_claude(root_dir, title[:48], " ".join(parts))
    ensure_agent_session(block, root=root_dir, title=title, kitty_pid=pid)
    print(block["id"])


def cmd_open(args: argparse.Namespace) -> None:
    """Open a block id (continue), or park+launch for jira/PR/Slack."""
    target = (args.target or "").strip()

    # Block id (from panel / launcher card) → continue, do not re-seed "Start working on".
    if re.fullmatch(r"[0-9a-f]{8}", target):
        node = resolve_node(target)
        if not node:
            die(f"unknown {target}")
        if node.get("kind") == "block":
            open_existing_block(node, args.root)
            return
        prof = node_profile(node)
        for nid in neighbors(node["id"], prof):
            n = get_node(nid, prof)
            if n and n.get("kind") == "block":
                open_existing_block(n, args.root)
                return
        die(f"no block linked to {target}")

    if is_slack_url(target):
        block = ensure_block_for_slack(target, title=args.title)
        tab = "slack"
        seed = f"Help with this Slack thread: {target}"
        if args.title:
            seed += f" ({args.title})"
    elif target.startswith(("http://", "https://")) and is_pr_url(target):
        block, _cr = ensure_block_for_review(target, title=args.title)
        tab = "review"
        seed = f"Code review this PR/MR: {target}"
        if args.title:
            seed += f" — {args.title}"
    else:
        key = parse_jira_token(target)
        block = ensure_block_for_jira(key, title=args.title or key)
        tab = key
        seed = f"Start working on {key}."
        if args.title:
            seed += f" {args.title}"

    prof = node_profile(block)
    root = resolve_root(args.root, profile=prof)
    if not Path(root).is_dir():
        die(f"root is not a directory: {root}")

    # /slate <link> Open session: raise live window if we already launched one.
    if focus_block_window(block):
        print(f"block={block['id']} profile={prof} focused existing kitty", file=sys.stderr)
        print(block["id"])
        return

    resume_id = _best_claude_resume(block)
    title = block.get("title") or tab
    if resume_id:
        print(f"block={block['id']} profile={prof} root={root} resume={resume_id}", file=sys.stderr)
        pid = launch_claude(root, str(tab)[:48], None, resume_id=resume_id)
        ensure_agent_session(block, root=root, title=str(title), kitty_pid=pid, claude_sid=resume_id)
    else:
        print(f"block={block['id']} profile={prof} root={root}", file=sys.stderr)
        pid = launch_claude(root, str(tab)[:48], seed)
        ensure_agent_session(block, root=root, title=str(title), kitty_pid=pid)
    print(block["id"])


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="slate", description="Personal work ledger")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser(
        "profile",
        help="show / pin / auto / default profile (default used outside Ithaka cwd)",
    )
    sp.add_argument(
        "name",
        nargs="*",
        help="ithaka | personal | auto | default ithaka|personal",
    )
    sp.set_defaults(func=cmd_profile)

    sp = sub.add_parser("block", help="block card ops")
    bsub = sp.add_subparsers(dest="block_cmd", required=True)
    bsp = bsub.add_parser("start", help="create open block")
    bsp.add_argument("title", nargs="*")
    bsp.add_argument("--next", default="")
    bsp.set_defaults(func=cmd_block_start)

    sp = sub.add_parser("start", help="agent_session linked to a block")
    sp.add_argument("title", nargs="*")
    sp.add_argument("--root")
    sp.add_argument("--block")
    sp.add_argument("--jira")
    sp.add_argument(
        "--claude-session",
        help="Claude conversation UUID (default: $CLAUDE_CODE_SESSION_ID from agent Bash)",
    )
    sp.set_defaults(func=cmd_start)

    sp = sub.add_parser("add", help="add stub node")
    sp.add_argument("kind", choices=["jira", "code_review", "slack", "pagerduty"])
    sp.add_argument("ref")
    sp.add_argument("--title")
    sp.set_defaults(func=cmd_add)

    sp = sub.add_parser("link")
    sp.add_argument("a")
    sp.add_argument("b")
    sp.set_defaults(func=cmd_link)

    sp = sub.add_parser("unlink")
    sp.add_argument("a")
    sp.add_argument("b")
    sp.set_defaults(func=cmd_unlink)

    sp = sub.add_parser("note")
    sp.add_argument("id")
    sp.add_argument("text", nargs="+")
    sp.set_defaults(func=cmd_note)

    sp = sub.add_parser("next")
    sp.add_argument("block")
    sp.add_argument("text", nargs="+")
    sp.set_defaults(func=cmd_next)

    sp = sub.add_parser("status")
    sp.add_argument("block")
    sp.add_argument("status", choices=["open", "done"])
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("done")
    sp.add_argument("id")
    sp.set_defaults(func=cmd_done)

    sp = sub.add_parser("done-block")
    sp.add_argument("id")
    sp.set_defaults(func=cmd_done_block)

    sp = sub.add_parser(
        "prune",
        help="collapse duplicate open agent_sessions on a block (or all open blocks)",
    )
    sp.add_argument("block", nargs="?", help="block id / jira:KEY (default: all open blocks)")
    sp.set_defaults(func=cmd_prune)

    sp = sub.add_parser("show")
    sp.add_argument("id")
    sp.set_defaults(func=cmd_show)

    sp = sub.add_parser("ls", help="open blocks (both profiles; cwd no longer hides ithaka)")
    sp.add_argument("--all", action="store_true", help="include recent done")
    sp.add_argument("--profile", choices=["ithaka", "personal"], help="one profile only")
    sp.add_argument("--json", action="store_true", help="machine-readable list for noctalia-slate")
    sp.add_argument(
        "--all-profiles",
        action="store_true",
        help=argparse.SUPPRESS,
    )  # ponytail: kept as no-op alias; ls already shows both
    sp.set_defaults(func=cmd_ls)
    sp = sub.add_parser(
        "capture",
        help="jira key/url → block + jira child (no session; use open to launch)",
    )
    sp.add_argument("token")
    sp.add_argument("--title")
    sp.set_defaults(func=cmd_capture)

    sp = sub.add_parser("review", help="PR/MR url → block + code_review")
    sp.add_argument("url")
    sp.add_argument("--jira")
    sp.add_argument("--title")
    sp.set_defaults(func=cmd_review)

    sp = sub.add_parser(
        "park",
        help="block only (no session): jira / PR/MR / Slack permalink",
    )
    sp.add_argument("target")
    sp.add_argument("--title")
    sp.set_defaults(func=cmd_park)

    sp = sub.add_parser(
        "open",
        help="kitty+claude: jira key/url, PR/MR url, or Slack permalink",
    )
    sp.add_argument(
        "target",
        help="JIRA key/url | GitHub/GitLab PR/MR url | Slack archives/… permalink",
    )
    sp.add_argument("--root")
    sp.add_argument("--title")
    sp.set_defaults(func=cmd_open)

    return p


def main() -> None:
    # allow `slate block start` via argparse nesting — handled
    parser = build_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
