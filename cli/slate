def review_title_from_url(url: str) -> str:
    path = urlparse(url).path.rstrip("/")
    parts = path.split("/")
    if "merge_requests" in parts:
        i = parts.index("merge_requests")
        # GitLab: /group/repo/-/merge_requests/N
        if i >= 2 and parts[i - 1] == "-":
            repo = parts[i - 2]
        else:
            repo = parts[i - 1] if i > 0 else "repo"
        num = parts[i + 1] if i + 1 < len(parts) else "?"
        return f"Review: {repo}!{num}"
    if "pull" in parts:
        i = parts.index("pull")
        repo = parts[i - 1] if i > 0 else "repo"
        num = parts[i + 1] if i + 1 < len(parts) else "?"
        return f"Review: {repo}#{num}"
    host = urlparse(url).hostname or "review"
    return f"Review: {host}"


